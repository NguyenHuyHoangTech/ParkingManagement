# =====================================================================
# PBMS FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# Copy to .env and adjust if connecting to a remote backend
# =====================================================================

# API Base URL (default uses Vite proxy for seamless local development)
VITE_API_URL=/api/v1
VITE_BASE_URL=

# To connect directly without Vite proxy:
# VITE_API_URL=http://localhost:8080/api/v1
# VITE_BASE_URL=http://localhost:8080
